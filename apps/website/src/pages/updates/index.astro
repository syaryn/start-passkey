---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_LAST_UPDATED } from "../../data/navigation.ts";

const entries = [
  {
    date: "2026-11-07",
    title: "Amazon セラーセントラル・au ID の区分を更新",
    body: "公式情報の再確認に基づき、Amazon セラーセントラルと au ID をパスキー対応に更新しました（いずれも登録は任意。セラーセントラルでパスワードログインを使う場合は2段階認証が引き続き必要）。",
  },
  {
    date: "2026-11-07",
    title: "三菱UFJ銀行（三菱UFJダイレクト）を追加",
    body: "掲載データに三菱UFJ銀行本体のダイレクトバンキングを追加しました（MUFGあんしんパス／FIDO 準拠の端末生体認証。掲載 575 件→576 件）。",
  },
];
---

<BaseLayout
  title="更新履歴｜そしてパスキーへ"
  description="サイト構成や掲載方針の主な変更を記録します。"
>
  <h1 class="dads-std-28b-150" style="margin: 0 0 0.5rem;">更新履歴</h1>
  <p class="dads-std-14n-170 dads-text-secondary" style="margin: 0 0 2rem;">
    最終更新: {SITE_LAST_UPDATED}
  </p>

  <ol class="dads-updates-list">
    {
      entries.map((entry) => (
        <li>
          <time datetime={entry.date}>{entry.date}</time>
          <h2>{entry.title}</h2>
          <p>{entry.body}</p>
        </li>
      ))
    }
  </ol>

  <p style="margin-top: 2.5rem;">
    <a href="/">← トップへ</a>
  </p>
</BaseLayout>
