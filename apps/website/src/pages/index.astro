---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryGroupNav from "../components/CategoryGroupNav.astro";
import { listCategoryGroupsForDisplay } from "../data/category-groups.ts";
import { formatRecommendationShare, RECOMMENDATION_LABELS, RECOMMENDATION_STATS_ORDER, countEntriesByCategory, summarizeEntries, toSearchHits } from "../data/display.ts";
import { SITE_LAST_UPDATED } from "../data/navigation.ts";
import { HOME_TITLE, SITE_NAME } from "../data/site.ts";

const collection = await getCollection("entries");
const entries = collection.map((item) => item.data);
const stats = summarizeEntries(entries);
const categoryCounts = countEntriesByCategory(entries);
const categoryGroups = listCategoryGroupsForDisplay(categoryCounts);
const searchPayload = collection.flatMap((item) => toSearchHits(item.data, item.id));
const searchJson = JSON.stringify(searchPayload);
---

<BaseLayout title={HOME_TITLE}>
  <header class="dads-page-header">
    <h1 class="dads-std-28b-150" style="margin: 0 0 0.5rem;">{SITE_NAME}</h1>
    <p class="dads-std-16n-170 dads-text-secondary dads-lead">
      パスワードだけのログインを、対応しているサービスから設定し直すための一覧です。
    </p>
    <p class="dads-std-14n-170 dads-text-secondary dads-lead">
      はじめての方は
      <a href="/guide/passkey/">パスキーとは</a>、
      <a href="/guide/how-to-use/">このサイトの使い方</a>、
      <a href="/faq/">よくある質問</a>もご覧ください。
    </p>
  </header>

  <section id="site-stats" class="dads-stats-summary" aria-labelledby="stats-heading">
    <h2 id="stats-heading" class="dads-std-20b-150">掲載状況（集計）</h2>
    <p class="dads-stats-total">
      掲載サービス数 <strong>{stats.total.toLocaleString("ja-JP")}</strong> 件
    </p>
    <dl class="dads-stats-grid">
      {
        RECOMMENDATION_STATS_ORDER.map((recommendation) => {
          const count = stats.byRecommendation[recommendation];
          const share = formatRecommendationShare(count, stats.total);
          return (
            <div class="dads-stats-item">
              <dt>{RECOMMENDATION_LABELS[recommendation]}</dt>
              <dd>
                <span class="dads-stats-count">{count.toLocaleString("ja-JP")} 件</span>
                <span class="dads-stats-percent">{share}</span>
              </dd>
            </div>
          );
        })
      }
    </dl>
    <p class="dads-stats-footnote">
      「いま切り替えるなら」列の区分ごとの件数です（{SITE_LAST_UPDATED} 時点のデータ）。詳しくは
      <a href="/guide/priority/">どれから設定するか</a>を参照してください。
    </p>
  </section>

  <section class="dads-search-field" aria-labelledby="search-heading">
    <h2 id="search-heading" class="dads-std-20b-150" style="margin: 0 0 1rem;">サービスを検索</h2>
    <label for="search-input" class="dads-std-16b-170">キーワード</label>
    <p id="search-help" class="dads-text-support" style="margin: 0.25rem 0 0.5rem;">
      表示名、よみがな、ドメイン、または委譲サービス名・読みで部分一致します。
    </p>
    <input
      type="search"
      id="search-input"
      name="q"
      class="dads-input"
      placeholder="例: らくてん、example.com"
      autocomplete="off"
      aria-describedby="search-help"
    />
  </section>

  <section id="search-results" class="dads-hidden" aria-live="polite" style="margin-bottom: 2.5rem;">
    <h2 class="dads-std-20b-150" style="margin: 0 0 0.75rem;">検索結果</h2>
    <ul id="search-results-list" style="margin: 0; padding-left: 1.5rem;"></ul>
  </section>

  <section id="category-list">
    <h2 class="dads-std-20b-150" style="margin: 0 0 0.5rem;">カテゴリ</h2>
    <p class="dads-text-support" style="margin: 0 0 1.25rem;">
      分野ごとにまとめています。件数はカテゴリ内の掲載数です。
    </p>
    <CategoryGroupNav groups={categoryGroups} />
  </section>

  <script type="application/json" id="search-data" set:html={searchJson} />
  <script>
    type SearchHit = {
      kind: "entry" | "delegated";
      href: string;
      entryName: string;
      recommendationLabel: string;
      domain: string;
      delegatedName?: string;
      matchName: string;
      matchReading: string;
      matchDomain?: string;
    };

    function parseSearchData(): SearchHit[] {
      const el = document.getElementById("search-data");
      if (!el?.textContent) return [];
      return JSON.parse(el.textContent) as SearchHit[];
    }

    function matches(hit: SearchHit, query: string): boolean {
      const q = query.trim();
      if (!q) return false;
      if (hit.matchName.includes(q) || hit.matchReading.includes(q)) {
        return true;
      }
      if (hit.kind === "entry" && hit.matchDomain) {
        return hit.matchDomain.toLowerCase().includes(q.toLowerCase());
      }
      return false;
    }

    const data = parseSearchData();
    const input = document.getElementById("search-input") as HTMLInputElement;
    const resultsSection = document.getElementById("search-results");
    const resultsList = document.getElementById("search-results-list");
    const categoryList = document.getElementById("category-list");
    const statsSection = document.getElementById("site-stats");

    function renderResults(query: string) {
      if (!resultsSection || !resultsList || !categoryList) return;

      const trimmed = query.trim();
      if (!trimmed) {
        resultsSection.classList.add("dads-hidden");
        resultsList.replaceChildren();
        categoryList.classList.remove("dads-hidden");
        statsSection?.classList.remove("dads-hidden");
        return;
      }

      const hits = data.filter((hit) => matches(hit, trimmed));
      categoryList.classList.add("dads-hidden");
      statsSection?.classList.add("dads-hidden");
      resultsSection.classList.remove("dads-hidden");
      resultsList.replaceChildren();

      if (hits.length === 0) {
        const li = document.createElement("li");
        li.textContent = "一致するサービスはありません。";
        resultsList.append(li);
        return;
      }

      for (const hit of hits) {
        const li = document.createElement("li");
        if (hit.kind === "delegated" && hit.delegatedName) {
          li.append(`${hit.delegatedName}は `);
          const link = document.createElement("a");
          link.href = hit.href;
          link.textContent = hit.entryName;
          li.append(link);
          li.append("でログインします");
        } else {
          const link = document.createElement("a");
          link.href = hit.href;
          link.textContent = hit.entryName;
          li.append(link);
          li.append(` — ${hit.recommendationLabel}（${hit.domain}）`);
        }
        resultsList.append(li);
      }
    }

    input?.addEventListener("input", () => renderResults(input.value));
  </script>
</BaseLayout>
