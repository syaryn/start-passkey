---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FAQ_ITEMS } from "../../data/faq.ts";
import { SITE_LAST_UPDATED } from "../../data/navigation.ts";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="よくある質問｜そしてパスキーへ"
  description="パスキーが使えないとき、SMS の安全性、一覧の見方、非公式サイトであることなど、よくある疑問への回答。"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <p style="margin: 0 0 1rem;">
    <a href="/sitemap/#guide">← サイトマップ（ガイド）</a>
  </p>
  <h1 class="dads-std-28b-150" style="margin: 0 0 0.5rem;">よくある質問</h1>
  <p class="dads-std-14n-170 dads-text-secondary" style="margin: 0 0 2rem;">
    最終更新: {SITE_LAST_UPDATED}
  </p>

  <dl class="dads-faq-list">
    {
      FAQ_ITEMS.map((item) => (
        <>
          <dt>{item.question}</dt>
          <dd>{item.answer}</dd>
        </>
      ))
    }
  </dl>

  <p style="margin-top: 2.5rem;">
    関連: <a href="/guide/how-to-use/">このサイトの使い方</a>、
    <a href="/guide/priority/">どれから設定するか</a>、
    <a href="/guide/troubleshooting/">困ったとき</a>
  </p>
</BaseLayout>
