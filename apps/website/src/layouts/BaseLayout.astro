---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import {
  AUTH_GUIDE_LINKS,
  POLICY_LINKS,
  SITE_GUIDE_LINKS,
  UTILITY_LINKS,
} from "../data/navigation.ts";
import { DEFAULT_DESCRIPTION, SITE_NAME } from "../data/site.ts";
import { themeBootstrapScript } from "../data/theme.ts";

interface Props {
  title: string;
  description?: string;
}

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og/default.png", Astro.site);
---

<!doctype html>
<html lang="ja" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={themeBootstrapScript()} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="dads-site-body">
    <a href="#main-content" class="dads-skip-link">本文へ移動</a>

    <header class="dads-site-header">
      <div class="dads-site-header-inner">
        <a href="/" class="dads-site-logo">
          <span class="dads-std-20b-150">{SITE_NAME}</span>
        </a>
        <div class="dads-site-header-actions">
          <nav class="dads-site-nav" id="site-nav" aria-label="メイン">
            <ul>
              <li>
                <a href="/sitemap/#guide">ガイド</a>
              </li>
              <li>
                <a href="/faq/">FAQ</a>
              </li>
              <li>
                <a href="/about/">このサイトについて</a>
              </li>
            </ul>
          </nav>
          <ThemeToggle />
          <button
            type="button"
            class="dads-site-menu-btn"
            id="site-menu-button"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="メニューを開く"
          >
            <span class="i-lucide-menu dads-icon-inline dads-site-menu-icon" data-menu-icon aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </header>

    <noscript>
      <style>
        @media (max-width: 767px) {
          .dads-site-menu-btn {
            display: none;
          }
          .dads-site-nav {
            display: block;
            position: static;
            padding: 0;
            border-bottom: none;
            box-shadow: none;
          }
        }
      </style>
    </noscript>

    <script>
      const menuButton = document.getElementById("site-menu-button");
      const siteNav = document.getElementById("site-nav");
      if (menuButton && siteNav) {
        const menuIcon = menuButton.querySelector("[data-menu-icon]");
        const setMenuOpen = (open: boolean) => {
          menuButton.setAttribute("aria-expanded", String(open));
          menuButton.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
          if (open) {
            siteNav.setAttribute("data-open", "true");
          } else {
            siteNav.removeAttribute("data-open");
          }
          if (menuIcon) {
            menuIcon.className = `${open ? "i-lucide-x" : "i-lucide-menu"} dads-icon-inline dads-site-menu-icon`;
          }
        };
        menuButton.addEventListener("click", () => {
          setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && menuButton.getAttribute("aria-expanded") === "true") {
            setMenuOpen(false);
            menuButton.focus();
          }
        });
        siteNav.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            setMenuOpen(false);
          }
        });
        window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
          if (event.matches) {
            setMenuOpen(false);
          }
        });
      }
    </script>

    <main id="main-content" class="dads-site-main dads-content">
      <slot />
    </main>

    <footer class="dads-site-footer">
      <div class="dads-site-footer-inner">
        <p class="dads-std-14n-170 dads-text-secondary" style="margin: 0 0 1rem;">
          掲載内容は確認日時点の情報です。設定方法は各サービスの公式ヘルプを参照してください。
        </p>
        <nav aria-label="フッター" class="dads-site-footer-grid">
          <div>
            <p class="dads-site-footer-heading">認証のしくみについて</p>
            <ul>
              {
                AUTH_GUIDE_LINKS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="dads-site-footer-heading">サイトの解説</p>
            <ul>
              {
                SITE_GUIDE_LINKS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="dads-site-footer-heading">ポリシー</p>
            <ul>
              {
                POLICY_LINKS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="dads-site-footer-heading">その他</p>
            <ul>
              {
                UTILITY_LINKS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
      </div>
    </footer>
  </body>
</html>
